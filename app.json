{
  "expo": {
    "name": "Momentum",
    "slug": "momentum",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "momentum",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./brandImages/momentum-app-logo-no-bg.png",
      "resizeMode": "contain",
      "backgroundColor": "#060a16"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.amaanpranjal.momentum",
      "appleTeamId": "NR42GN3S2T",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserTrackingUsageDescription": "We use this to show you relevant ads and keep Momentum free."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#060a16"
      },
      "package": "com.amaanpranjal.momentum",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#060a16",
          "image": "./brandImages/momentum-app-logo-no-bg.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#8833ff"
        }
      ],
      "expo-tracking-transparency",
      "expo-apple-authentication",
      "expo-font",
      "expo-audio",
      "expo-web-browser",
      "expo-asset",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-2468139254817625~1038010491",
          "iosAppId": "ca-app-pub-2468139254817625~3720014156",
          "delayAppMeasurementInit": true,
          "userTrackingUsageDescription": "We use this to show you relevant ads and keep Momentum free."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "693b46ce-bd42-482b-8cdd-c317eb321153"
      }
    }
  }
}
